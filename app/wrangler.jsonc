{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plutus",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "plutus", "database_id": "d0ce91f8-0ae6-4844-99a8-846ed46caaf6", "migrations_dir": "migrations" }
  ],
  "triggers": {
    "crons": ["0 6 25 * *"]
  },
  "observability": { "enabled": true },
  // Account: denweb82 (ddcd0a9eefadc42e5826dcbc4ef94cd4), the account plutus.denweb82.workers.dev runs on. Pointed back here 22 Nov 2026; the Worker in the logia account (docs/20) could not be verified.
  // Restore also needs the RESTORE_CODE secret (Cloudflare dashboard). Without it restore stays off, even with this switch on.
  "vars": { "RESTORE_ENABLED": "0" }
}
