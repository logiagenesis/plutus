{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accounting666",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "accounting666", "database_id": "819d4a2d-8f85-42d3-8ce2-e2142282b88a", "migrations_dir": "migrations" }],
  "observability": { "enabled": true },
  // Set these after Cloudflare Access is configured (Workers dashboard → Settings → Variables). Until then the API refuses to serve data.
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
}
